{
  "name": "vocalis",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build",
    "test:engine": "tsx tests/textAnalysis.test.ts",
    "test:render": "tsx --max-old-space-size=3072 tests/renderSpeech.test.ts",
    "test:voices": "tsx tests/voiceLibrary.test.ts",
    "voices": "tsx scripts/voice_library.ts",
    "start": "tsx server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "audit": "npm run lint && npm run verify:base-voice",
    "verify:base-voice": "node scripts/check_base_voice.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
